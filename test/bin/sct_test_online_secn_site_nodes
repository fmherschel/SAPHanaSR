set -u
src=${BASH_SOURCE[0]}
full_path=$(readlink -f "$src")
dir_path=$(dirname "$full_path")
source /usr/lib/SAPHanaSR-tester/sct_test_lib
source .test_properties
currSecondary="$sHost"
currSecnWorker="$sWorker"

echo "==== SUSE cluster online on secondary site node ${currSecondary} ===="
# shellcheck disable=SC2029
sctl_run_crm "${currSecondary}" "node online" &
echo "==== SUSE cluster online on secondary site node ${currSecnWorker} ===="
sctl_run_crm "${currSecnWorker}" "node online" &
#
