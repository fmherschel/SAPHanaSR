myVersion="3.2.1 2026-11-05"
paramMode="basic"
remoteNodes=""
testCases=""
seperator=" "


function f_version() {
    /usr/bin/rpm -q SAPHanaSR-tester || echo "sct_runtests $myVersion"
}

function f_help() {
    case "$1" in
        pages)
            /usr/bin/rpm -ql SAPHanaSR-tester |\
            /usr/bin/awk -F"/" '$4=="man" {print $6}' |\
            while read; do echo ${REPLY::-5}; done
        ;;
        self)
            echo
            echo "usage     $EXE --case <case> [ --testCases <tests> ] --remoteNodes <nodes>"
            echo "usage     $EXE --caseFile <file> [ --testCases <tests> ] --remoteNodes <nodes>"
            echo "usage     $EXE --sample [ samples | <sample> ]"
            echo "usage     $EXE --help [ pages | <page> ]"
            echo "usage     $EXE --version"
            echo
            echo " --case           predefined test case"
            echo " --caseFile       sample file with scenario and tests"
            echo " --testCases      tests to execute"
            echo " --remoteNodes    cluster nodes"
            echo " --sample         show sample"
            echo " --help           show help"
            echo " --version        show version"
            echo
        ;;
        *)
            /usr/bin/man "$1"
        ;;
    esac
}

function f_sample() {
    case "$1" in
        samples)
            # txt: Text eXecution Template
            /usr/bin/ls /usr/share/SAPHanaSR-tester/samples/runtests_*.txt |\
            while read; do /usr/bin/basename $REPLY ".txt"; done
        ;;
        *)
            if [[ -n "$1" ]]; then
                /usr/bin/cat /usr/share/SAPHanaSR-tester/samples/"$1".txt
            fi
        ;;
    esac
}

# main()

if [[ "$#" -eq 0 ]]; then
    f_help self
    exit
fi
case "$1" in
        -v|--version)
            f_version
            exit
        ;;
        -h|--help)
            if [[ "$#" -eq 1 ]]; then
                f_help self
                exit
            fi
            shift
            f_help "$*"
            exit
        ;;
        -s|--sample)
            shift
            f_sample "$1"
            exit
        ;;
esac

# TODO below in function

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --case ) 
            masterCase="$2"
            shift
            paramMode="basic"
            ;;
        --caseFile )
            caseFile="$2"            
            shift
            paramMode="basic"
            ;;
        --testCases )
            paramMode="testCases"
            ;;
        --remoteNodes )
            paramMode="remoteNodes"
            ;;
        * )
            newValue="$1"
            case "$paramMode" in
                testCases )
                    testCases="${testCases:+$testCases$seperator}$newValue"
                    ;;
                remoteNodes )
                    remoteNodes="${remoteNodes:+$remoteNodes$seperator}$newValue"
                    ;;
            esac
            ;;
    esac
    shift
done

echo "masterCase=$masterCase"
echo "caseFile=$caseFile"
echo "remoteNodes=$remoteNodes"
echo "testCases=$testCases"

if [[ -n "$caseFile" ]]; then
    CASFILE="$caseFile"
elif [[ -n "$masterCase" ]]; then
    CASFILE="/usr/share/SAPHanaSR-tester/samples/runtests_${masterCase}.txt"
else
    echo "Neither masterCase nor caseFile specified, exit"
    exit 1
fi

if [[ -n "$remoteNodes" ]]; then
   echo "No remoteNodes specified, exit"
   exit 1
fi

source "$CASFILE" || exit 1

REMOTENODES="$remoteNodes"
SLEEP=120

exec 3>&1
exec 1>>"$LOGFILE"

A_TCASES=( $TCASES )
NR_TCASES=${#A_TCASES[*]}

TESTS_PASSED=""
TESTS_FAILED=""

i=0
rc=0
while [[ "$i" -lt "$NR_TCASES" ]]; do
  TEST="${A_TCASES[$i]}"
  (( i++ ))
  echo "#### $(date +%Y-%m-%d" "%H:%M:%S) run test: $TEST ####"
  echo "$(date +%Y-%m-%d" "%H:%M:%S) TEST $i/$NR_TCASES - $TEST" >&3
  if true; then
      /usr/bin/SAPHanaSR-testCluster \
            --testFile "$ASTROOT/$TEST.json" \
            --remoteNodes $REMOTENODES --defaultsFile "$ASTROOT/defaults.json" \
            --logFile "$TEST.log" --jsonOut "$TEST.json.out" \
            --onFail exit \
            --properties "$PROPERTIES" --dumpFailures >&3; rc=$?
      echo "#### $(date +%Y-%m-%d" "%H:%M:%S) end test: $TEST rc: $rc ####"
    if [[ "$rc" != "0" ]]; then
        TESTS_FAILED="$TESTS_FAILED $TEST"
        rc=1
        break
    else
        TESTS_PASSED="$TESTS_PASSED $TEST"
        echo "$(date +%Y-%m-%d" "%H:%M:%S) TESTS_PASSED=$TESTS_PASSED" >&3
        if [[ "$TEST" =~ "flup" ]]; then
            echo "sleep 1" >&3
            sleep 1
        elif [[ "$i" -ge "$NR_TCASES" ]]; then
             echo "no sleep" >&3
        else
            echo "sleep ${SLEEP}" >&3
            echo "$(date +%Y-%m-%d" "%H:%M:%S) TEST $i/$NR_TCASES - $TEST - sequence took ${SECONDS}s" >&3
            sleep $SLEEP
        fi
    fi
  else
      ls -l "$ASTROOT/$TEST.json.out" 1>&2
  fi
  echo "$(date +%Y-%m-%d" "%H:%M:%S) TEST $i/$NR_TCASES - $TEST - sequence took ${SECONDS}s" >&3
done
echo "$(date +%Y-%m-%d" "%H:%M:%S) TESTS_PASSED=$TESTS_PASSED" >&3
if [[ "$rc" != 0 ]]; then
	echo "$(date +%Y-%m-%d" "%H:%M:%S) TESTS_FAILED=$TESTS_FAILED" >&3
fi
echo "$(date +%Y-%m-%d" "%H:%M:%S) Runtime: $SECONDS" >&3
exit "$rc"
#
