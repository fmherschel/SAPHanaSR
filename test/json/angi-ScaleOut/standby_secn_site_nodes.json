{
    "test": "standby_secn_site_node",
    "name": "standby secondary site nodes (and online again)",
    "purpose": [
        "angi",
        "ScaleOut",
        "standby",
        "maintenance",
        "secondary",
        "site",
        "node",
        "master",
        "worker"
    ],
    "start": "prereq10",
    "steps": [
        {
            "step": "prereq10",
            "name": "test prerequisites",
            "next": "step20",
            "loop": 1,
            "wait": 1,
            "post": "shell sct_test_standby_secn_site_nodes",
            "pSite": "pSiteUp",
            "sSite": "sSiteUp",
            "pHost": "pHostUp",
            "sHost": "sHostUp",
            "pWorker": "pWorkerUp",
            "sWorker": "sWorkerUp"
        },
        {
            "step": "step20",
            "name": "nodes are standby",
            "next": "step30",
            "loop": 240,
            "wait": 2,
            "post": "shell sct_test_online_secn_site_nodes",
            "pSite": "pSiteUp",
            "pHost": "pHostUp",
            "pWorker": "pWorkerUp",
            "sSite": "sSiteDown",
            "sHost": "sHostStandby",
            "sWorker": "sWorkerStandby"
        },
        {
            "step": "step30",
            "name": "nodes back online",
            "next": "final40",
            "loop": 180,
            "wait": 2,
            "pSite": "pSiteUp",
            "pHost": "pHostUp",
            "pWorker": "pWorkerUp",
            "sSite": [
                "lpt == 10",
                "lss == 1",
                "srr == S",
                "srHook == SWAIT",
                "srPoll == SFAIL"
            ],
            "sHost": [
                "clone_state == DEMOTED",
                "roles == master1::worker:",
                "score ~ (-INFINITY|0)",
                "standby == off"
            ]
        },
        {
            "step": "final40",
            "name": "end recover",
            "next": "END",
            "loop": 180,
            "wait": 2,
            "post": "cleanup",
            "pSite": "pSiteUp",
            "sSite": "sSiteUp",
            "pHost": "pHostUp",
            "sHost": "sHostUp",
            "sWorker": "sWorkerUp",
            "pWorker": "pWorkerUp"
        }
    ]
}
