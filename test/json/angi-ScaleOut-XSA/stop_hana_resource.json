{
    "test": "stop_hana_resource",
    "name": "stop hana resource and restart it" ,
    "purpose": [
        "angi",
        "ScaleOut",
        "hana",
        "cluster",
        "maintenance",
        "stop"
    ],
    "start": "prereq10",
    "steps": [
        {
            "step": "prereq10",
            "name": "test prerequisites",
            "next": "step20",
            "loop": 1,
            "wait": 1,
            "post": "stop_hana_resource",
            "mstRsc": "mstRscReady",
            "pSite": "pSiteUp",
            "sSite": "sSiteUp",
            "pHost": "pHostUp",
            "sHost": "sHostUp",
            "pWorker": "pWorkerUp",
            "sWorker": "sWorkerUp"
        },
        {
            "step": "step20",
            "name": "hana stopped",
            "next": "final40",
            "loop": 180,
            "wait": 2,
            "post": "start_hana_resource",
            "pSite": "pSiteDown",
            "sSite": [
                "lpt == 10",
                "lss == 1",
                "srr == S",
                "srHook ~ (SFAIL|SOK)",
                "srPoll ~ (SFAIL|SOK)"
            ],
            "pHost": [
                "clone_state == UNDEFINED",
                "score == 70"
            ],
            "sHost": [
                "clone_state == UNDEFINED",
                "roles == master1::worker:",
                "score ~ (0|-32300)"
            ],
            "pWorker": [
                "clone_state == UNDEFINED",
                "score ~ (101|-INFINITY)"
            ],
            "sWorker": [
                "clone_state == UNDEFINED",
                "roles == slave::none:",
                "score ~ (-12200|-INFINITY)" 
            ]
        },
        {
            "step": "final40",
            "name": "running again",
            "next": "END",
            "loop": 240,
            "wait": 2,
            "pSite": "pSiteUp",
            "sSite": "sSiteUp",
            "pHost": "pHostUp",
            "sHost": "sHostUp",
            "pWorker": "pWorkerUp",
            "sWorker": "sWorkerUp"
        }
    ]
}
