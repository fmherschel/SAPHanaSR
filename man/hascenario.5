.\" Version: 1.2
.\"
.TH hascenario 5 "4 Nov 2026" "" "ClusterTools2"
.\"
.SH NAME
.\"
hascenario \- HA scenario description.
.PP
.\"
.SH DESCRIPTION
.\"
The file /etc/sysconfig/hascenario should contain a structured description
of the HA scenario deployed on the Linux cluster.
.\" TODO rational
.\"
.\" TODO should /etc/sysconfig/hacluster be part of ClusterTools2?
.\" TODO should /usr/share/$RPM/samples/hacluster be part of SAPHanaSR... sapstartsrv-...?
.\"
.PP
.SH SYNTAX
.\"
.\" TODO follow sysconfig syntax
.\" TODO SCENARIO_<n>= or HANA|ENSA|CONTENT|CMCZ|DB2|DRBD|STORAGE|MISC|...= ?
SCENARIO_\fIN\fR="\fIMAIN\fR, [ \fITAG\fR [, \fITAG\fR [...] ]"
.PP
MAIN = [ hana | ensa | content | cmcz | db2 | drbd | storage | misc ]
.PP
\fB*\fR SAP HANA database scenarios
.PP
hana, classic, scale-up, perf-opt [,multi-sid [,read-enabled] ] [,cons ] 
.br
hana, classic, scale-up, [ perf-opt | cost-opt ] [, read-enabled] [,cons ] 
.br
hana, classic, scale-out, [,auto-failover [,read-enabled] ] [,cons ]
.br
hana, angi, scale-up, perf-opt, [ cons | prog ] [,read-enabled ]
.br
hana, angi, scale-up, perf-opt, cons, multi-sid [,read-enabled]
.br
hana, angi, scale-up, cost-opt, cons [,read-enabled]
.br
.\" TODO dr-region on DR-region or on both regions?
hana, angi, scale-up, dr-region, progressive
.br
hana, angi, scale-out, [ cons | prog ] [,read-enabled] ]
.br
hana, angi, scale-out, cons , auto-failover [,read-enabled] ]
.br
hana, angi, scale-out, xsa, progressive 
.PP
\fB*\fR SAP ENSA central services scenarios
.PP
ensa, [ ensa1 | ensa2 ], [ simple-mount | filesystem [,disk ] ]
.PP
\fB*\fR SAP CONTENT server scenario
.PP
\fB*\fR SAP Convergent Mediation ControlZone scenario
.PP
cmcz, platform [,ui ]
.PP
\fB*\fR IBM DB2 database scenarios
.PP
db2, [ simple | hadr ], ...
.PP
\fB*\fR DRBD storage scenario
.PP
drbd, ...
.PP
\fB*\fR Storage simple-stack scenario
.PP
storage, ...
.PP
\fB*\fR Miscellaneous scenarios
.PP
misc, ...
.PP
.\"
.SH EXAMPLES
.\"
\fB*\fR Example hascenario file for HANA.
.PP
SAPHanaSR-angi, scale-up, performance-optimised, progressive, 
no multi-sid, no read-enabled.
.PP
.RS 2
# /etc/sysconfig/hascenario - HA scenario description
.br
#
.br
## Path:        High Availability/Scenario
.br
## Type:        string
.br
## Default:     ""
.br
#
.br
SCENARIO_0="hana,classic,scale-up,perf-opt"
.br
#
.RE
.PP
.\"
.SH FILES
.\"
.TP
/etc/sysconfig/hascenario
the HA scenario description file
.PP
