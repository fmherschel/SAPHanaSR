.\" Version: 1.2
.\"
.TH hascenario 5 "4 Nov 2026" "" "ClusterTools2"
.\"
.SH NAME
.\"
hascenario \- HA scenario description.
.PP
.B - DRAFT -
.PP
.\"
.SH DESCRIPTION
.\"
The file /etc/sysconfig/hascenario should contain a structured description
of the HA scenario deployed on the Linux cluster.
.\" TODO rational
.\"
.\" TODO should /etc/sysconfig/hacluster be part of ClusterTools2?
.\" TODO should /usr/share/$RPM/samples/hacluster be part of SAPHanaSR... sapstartsrv-...?
.\"
.PP
.SH SYNTAX
.\"
.\" TODO follow sysconfig syntax
.\" TODO SCENARIO_<n>= or HANA|ENSA|CONTENT|CMCZ|DB2|DRBD|STORAGE|MISC|...= ?
#
.br
SCENARIO_\fIN\fR="\fIMAIN\fR,\fITAG\fR,[ \fITAG\fR [...] ]"
.br
#
.br
CLUSTER="\fITAG\fR,[ \fITAG\fR [...] ],\fIPLATFORM\fR"
.br
#
.PP
.RS 2
MAIN = [ hana | ensa | content | cmcz | db2 | drbd | storage | misc ]
.br
PLATFORM = [ metal | kvm | vmware | powervm | azure | ec2 | gcp | ... ]
.RE
.PP
.PP
\fB*\fR SAP HANA database system replication scenarios
.PP
hana, classic, scale-up, perf-opt [,multi-sid [,read-enabled] ][,cons] 
.br
hana, classic, scale-up, [ perf-opt | cost-opt ][,read-enabled][,cons] 
.br
hana, classic, scale-out, [,auto-failover [,read-enabled] ][,cons]
.br
hana, angi, scale-up, perf-opt, [ cons | prog ][,read-enabled]
.br
hana, angi, scale-up, perf-opt, cons, multi-sid [,read-enabled]
.br
hana, angi, scale-up, cost-opt, cons [,read-enabled]
.br
hana, angi, scale-up, dr-region, prog
.br
hana, angi, scale-out, [ cons | prog ][,read-enabled] ]
.br
hana, angi, scale-out, cons, auto-failover [,read-enabled] ]
.br
hana, angi, scale-out, xsa, prog
.PP
\fB*\fR SAP ENSA central services scenarios
.PP
ensa, [ ensa1 | ensa2 ], [ simple-mount | filesystem [,disk] ][,multi-sid]
.PP
\fB*\fR SAP CONTENT server scenario
.PP
\fB*\fR SAP Convergent Mediation ControlZone scenario
.PP
cmcz, platform [,ui]
.PP
\fB*\fR IBM DB2 database HADR scenario
.PP
db2, hadr, ...
.PP
\fB*\fR DRBD storage scenario
.PP
drbd, ...
.PP
\fB*\fR Simple-stack scenarios
.PP
simple, disk, [ raid1 | asm ], [ db2 | oracle | ase | maxdb | pgsql | ascs | pas | ... ]
.br
simple, nfs, [ ascs | pas | ... ]
.PP
\fB*\fR Miscellaneous scenarios
.PP
misc, ...
.PP
\fB*\fR Basic cluster setup
.PP
cluster, 2-node, [ 1-sbd | 2-sbd | 3-sbd | redfish | ... ],\fINETWORK\fR,\fIPLATFORM\fR
.br
cluster, [ 3-node | majority-maker | qdevice ],\fIFENCING\fR,\fINETWORK\fR,\fIPLATFORM\fR
.PP
.RS 2
FENCING = [ 1-sbd | 2-sbd | 3-sbd | diskless-sbd | redfish | ... ]
.br
NETWORK = [ 1-corosync | 2-corosync | 1-knet | 2-knet | 3-knet ]
.br
PLATFORM = [ metal | kvm | vmware | powervm | azure | ec2 | gcp | ... ]
.RE
.PP
.\"
.SH EXAMPLES
.\"
\fB*\fR Example hascenario file for HANA system replication.
.PP
SAPHanaSR-angi, scale-up, performance-optimised, progressive, 
no multi-sid, no read-enabled.
.PP
.RS 2
# /etc/sysconfig/hascenario - HA scenario description
.br
#
.br
## Path:        High Availability/Scenario
.br
## Type:        string
.br
## Default:     ""
.br
#
.br
SCENARIO_0="hana,angi,scale-up,perf-opt,progressive"
.br
#
.br
CLUSTER="2-node,3-sbd,2-corosync,kvm"
.br
#
.RE
.PP
\fB*\fR Example hascenario file for simple-stack SLE12.
.PP
All-in-one simple-stack as in SAP HA on SLE12 enablement workshops.
MaxDB and NetWeaver active-passive cluster on simple-stack storage with
host-based mirror (Raid1, LVM2, Filesystem, IPaddr2, SAPInstance). 
.PP
.RS 2
# /etc/sysconfig/hascenario - HA scenario description
.br
#
.br
## Path:        High Availability/Scenario
.br
## Type:        string
.br
## Default:     ""
.br
#
.br
SCENARIO_0="simple,disk,raid1,lvm2,maxdb,ascs,pas"
.br
#
.br
CLUSTER="2-node,2-sbd,2-corosync,kvm"
.br
#
.\"
.SH FILES
.\"
.TP
/etc/sysconfig/hascenario
the HA scenario description file
.PP
