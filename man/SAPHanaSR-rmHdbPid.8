.\" Version: 1.2
.\"
.TH SAPHanaSR-rmHdbPid 8 "02 Jun 2026" "" "SAPHanaSR"
.\"
.SH NAME
.\"
SAPHanaSR-rmHdbPid \- removes left-over HANA hdbdaemon PID file
.PP
.\"
.SH SYNOPSIS
.\"
\fBSAPHanaSR-rmHdbPid\fR [ --help | --version | --force ]
.PP
.\"
.SH DESCRIPTION
.\"
SAPHanaSR-rmHdbPid can be used to remove HANA hdbdaemon PID files.
This might be useful, if a left-over PID file prevents HANA from starting right
after system boot.
.br
Do not call this script while HANA is running.
.PP
.\"
.SH OPTIONS
.\"
.TP 4
\fB --help\fR
show help.
.TP 4
\fB --version\fR
show version.
.TP 4
\fB --force\fR
force script execution.
.PP
.\"
.SH RETURN CODES
.\"
.B 0
Successful program execution.
.br
.B >0
Usage, syntax or execution errors.
.PP
.\"
.SH EXAMPLES
.\"
\fB*\fP enable systemd service sapRmHdbPid
.PP
# systemctl enable sapRmHdbPid
.br
# systemctl list-unit-files | grep -i sapRmHdbPid
.br
# systemctl status sapRmHdbPid
.br
# systemd-analyze dot | grep sapRmHdbPid
.PP
.\"
.SH FILES
.\"
.TP 4
/usr/bin/SAPHanaSR-rmHdbPid
the program itself.
.TP 4
/usr/sap/<SID>/HDB<INO>/<HOST>/lock/hdbdaemon@3<INO>00.pid
the PID file.
.PP
.\"
.SH BUGS
.\"
In case of any problem, please use your favourite SAP support process to open a
request for the component BC-OP-LNX-SUSE.
.\" TODO Please report any other feedback and suggestions to feedback@suse.com.
.PP
.\"
.SH REQUIREMENTS
.\"
\fB*\fP This script should run as systemd service at boot time.
It must not be called while HANA is running.
.PP
\fB*\fP The systemd service sapRmHdbPid needs to be enabled.
.PP
.\"
.SH SEE ALSO
.\"
\fBsystemctl\fP(8)
.PP
