function sht_monitor() {
    # called by: TODO
    super_ocf_log info "FLOW ${FUNCNAME[0]} ()"
    local rc=0
    local vName=""
    node_role_walk --standbyFilter=off
    # DONE: PRIO1: ASK: Is the output format of ListInstances fix? Could we take that as an API?
