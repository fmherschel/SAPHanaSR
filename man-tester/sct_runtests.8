.\" Version: 1.2
.\"
.TH sct_runtests 8 "4 Nov 2026" "" "SAPHanaSR-angi"
.\"
.SH NAME
.\"
sct_runtests \-  run predefined sets of tests.
.PP
.\"
.SH SYNOPSIS
.\"
\fBsct_runtests\fR --case \fICASE\fR [ --testCases \fITESTS\fR ] --remoteNodes \fINODES\fR
.br
\fBsct_runtests\fR --caseFile \fIFILE\fR [ --testCases \fITESTS\fR ] --remoteNodes \fINODES\fR
.br
\fBsct_runtests\fR --sample [ samples | \fISAMPLE\fR ]
.br
\fBsct_runtests\fR --help [ pages | \fIPAGE\fR ]
.br
\fBsct_runtests\fR --version
.PP
.SH DESCRIPTION
.\"
sct_runtests runs SAPHanaSR-testCluster with predefined sets of tests.
.br
For running single highly specified tests, see manual page SAPHanaSR-testCluster(8).
For running sct_runtests inside a podman container, see SAPHanaSR-tester-podman(7).
.PP
.\"
.SH OPTIONS
.\"
.TP
--help [ pages | \fIPAGE\fR ]
show usage, or list of manual pages, or given page
.TP
--case \fICASE\fR
TODO
.TP
--caseFile \fIFILE\fR
sample file with scenario and tests
.TP
.\" TODO sample vs. case ?
--sample [ samples | \fISAMPLE\fR ]
show list of samples, or show file for given sample
.TP
--testCases \fITEST\fR [ \fITEST\fR [ ... ]]
tests to execute
.TP
--remoteNodes \fINODE\fR [ \fINODE\fR ]
cluster nodes
.TP
--version
show version
.PP
.\"
.SH EXAMPLES
.\"
\fB*\fR Showing list of help topics.
.PP
.RS 2
# /usr/bin/sct_runtests --help topics
.RE
.PP
\fB*\fR Running a predefined set of tests.
.PP
TODO
properties file, scenario and tests are taken from 'runtests_angi-ScaleUp_conservative',
cluster nodes are 'node1' and 'node2'.
.PP
.RS 2
# /usr/bin/sct_runtests --case angi-ScaleUp_conservative \\
.br
 --remoteNodes node1 node2
.RE
.PP
.\"
.SH FILES
.\"
.TP
/usr/bin/sct_runtests
the script itself
.TP
/usr/share/SAPHanaSR-tester/samples/
directory with sets of tests
.TP
/usr/share/SAPHanaSR-tester/json/<\fISCENARIO\fR>/
directories with scenarios and their test definitions
.TP
\fI$PWD\fR/properties_<\fIscenario\fR>.json
test cluster properties, f.e. properties_ScaleUp.json
.TP
\fI$PWD\fR/runtests.log
testrun overall log
.TP
\fI$PWD\fR/<\fItest\fR>.log
per test log (test flow), repeating tests will append
.TP
\fI$PWD\fR/<\fItest\fR>.json.out
per test JSON output (status details), repeating tests will overwrite
.PP
